rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validCount(counts, index) {
      return index >= counts.size() || (counts[index] is int && counts[index] >= 1 && counts[index] <= 30);
    }
    function validEvent(data, eventId) {
      let counts = data.classGroupCounts;
      return data.keys().hasOnly(['id', 'name', 'classGroupCounts', 'createdAt', 'isExample', 'defaultGroupCount'])
        && eventId.matches("^[a-zA-Z0-9_-]{1,128}$") && data.id == eventId && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.createdAt is string && data.isExample == false
        && validCount([data.get("defaultGroupCount", 4)], 0)
        && counts is list && counts.size() >= 1 && counts.size() <= 30
        && validCount(counts, 0)
        && validCount(counts, 1)
        && validCount(counts, 2)
        && validCount(counts, 3)
        && validCount(counts, 4)
        && validCount(counts, 5)
        && validCount(counts, 6)
        && validCount(counts, 7)
        && validCount(counts, 8)
        && validCount(counts, 9)
        && validCount(counts, 10)
        && validCount(counts, 11)
        && validCount(counts, 12)
        && validCount(counts, 13)
        && validCount(counts, 14)
        && validCount(counts, 15)
        && validCount(counts, 16)
        && validCount(counts, 17)
        && validCount(counts, 18)
        && validCount(counts, 19)
        && validCount(counts, 20)
        && validCount(counts, 21)
        && validCount(counts, 22)
        && validCount(counts, 23)
        && validCount(counts, 24)
        && validCount(counts, 25)
        && validCount(counts, 26)
        && validCount(counts, 27)
        && validCount(counts, 28)
        && validCount(counts, 29);
    }
    function writableEvent(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.isExample == false
        && get(/databases/$(database)/documents/events/$(eventId)).data.get("deletedAt", null) == null;
    }
    function validGroup(eventId, groupId, data) {
      let counts = get(/databases/$(database)/documents/events/$(eventId)).data.classGroupCounts;
      return data.classNo is int && data.groupNo is int && data.classNo >= 1 && data.classNo <= counts.size()
        && data.groupNo >= 1 && data.groupNo <= counts[data.classNo - 1]
        && groupId == string(data.classNo) + '-' + string(data.groupNo) && data.id == groupId;
    }
    function locationTeacher() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/locationConfig/access).data.teacherUids;
    }
    match /locationConfig/access {
      allow get: if locationTeacher();
      allow list, write: if false;
    }
    match /events/{eventId} {
      allow read: if true;
      allow create: if locationTeacher() && validEvent(request.resource.data, eventId);
      allow update: if locationTeacher() && resource.data.isExample == false
        && resource.data.get("deletedAt", null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'classGroupCounts', 'defaultGroupCount'])
        && validEvent(request.resource.data, eventId);
      allow update: if locationTeacher() && resource.data.isExample == false
        && resource.data.get("deletedAt", null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt is string;
      allow delete: if false;
      match /locationInvites/{inviteId} {
        allow get: if request.auth != null && writableEvent(eventId);
        allow list: if false;
        allow create, update: if locationTeacher() && writableEvent(eventId)
          && inviteId.matches('^[a-f0-9]{32}$')
          && request.resource.data.keys().hasOnly(['classNo', 'groupNo', 'active'])
          && request.resource.data.active is bool
          && validGroup(eventId, string(request.resource.data.classNo) + '-' + string(request.resource.data.groupNo), {
            'id': string(request.resource.data.classNo) + '-' + string(request.resource.data.groupNo),
            'classNo': request.resource.data.classNo, 'groupNo': request.resource.data.groupNo
          });
        allow delete: if locationTeacher();
      }
      match /locationInviteIndex/{groupId} {
        allow read, write: if locationTeacher() && writableEvent(eventId);
      }
      match /locations/{groupId} {
        function validLocation() {
          let data = request.resource.data;
          let device = get(/databases/$(database)/documents/events/$(eventId)/locationDevices/$(groupId)).data;
          return request.auth != null && writableEvent(eventId)
            && data.keys().hasOnly(['classNo', 'groupNo', 'latitude', 'longitude', 'accuracy', 'measuredAt', 'receivedAt', 'publisherUid', 'bindingId'])
            && device.publisherUid == request.auth.uid && data.bindingId == device.bindingId
            && validGroup(eventId, groupId, {'id': groupId, 'classNo': data.classNo, 'groupNo': data.groupNo})
            && data.publisherUid == request.auth.uid
            && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
            && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
            && data.accuracy is number && data.accuracy >= 0
            && data.receivedAt == request.time
            && data.measuredAt is number && data.measuredAt >= request.time.toMillis() - 300000
            && data.measuredAt <= request.time.toMillis() + 60000;
        }
        allow read: if locationTeacher() && writableEvent(eventId);
        allow create: if validLocation();
        allow update: if validLocation() && resource.data.publisherUid == request.auth.uid
          && request.time >= resource.data.receivedAt + duration.value(180, 's');
        allow delete: if locationTeacher() || (request.auth != null && resource.data.publisherUid == request.auth.uid);
      }
      match /locationDevices/{groupId} {
        function validDevice() {
          let data = request.resource.data;
          let parts = groupId.split('-');
          return data.keys().hasAll(['publisherUid', 'bindingId'])
            && data.keys().hasOnly(['publisherUid', 'bindingId'])
            && data.bindingId is string && data.bindingId.matches('^[a-f0-9]{32}$')
            && parts.size() == 2
            && validGroup(eventId, groupId, {'id': groupId, 'classNo': int(parts[0]), 'groupNo': int(parts[1])});
        }
        allow get: if request.auth != null && writableEvent(eventId);
        allow list: if false;
        allow create: if request.auth != null && writableEvent(eventId) && validDevice()
          && (request.resource.data.publisherUid == request.auth.uid || (locationTeacher() && request.resource.data.publisherUid == null));
        allow update: if writableEvent(eventId) && validDevice() && (
          (locationTeacher() && request.resource.data.publisherUid == null)
          || (request.auth != null && resource.data.publisherUid == null
            && request.resource.data.publisherUid == request.auth.uid
            && request.resource.data.bindingId == resource.data.bindingId));
        allow delete: if locationTeacher() && writableEvent(eventId);
      }
      match /groups/{groupId} {
        allow read: if exists(/databases/$(database)/documents/events/$(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.get("deletedAt", null) == null;
        allow create, update: if writableEvent(eventId) && validGroup(eventId, groupId, request.resource.data);
        allow delete: if locationTeacher() && writableEvent(eventId);
      }
    }
    // Retain the legacy source for review, but stop obsolete clients changing it after cutover.
    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
